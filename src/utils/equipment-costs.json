    "comment": "Multiply by the number of points of armor or internal structure",
    "Standard": 625,
    "Ferro-Fibrous Armor": 781,
    "Standard Internal Structure": 250,
    "Endo Steel Structure": 3140
  },
  
  "formulas": {
    "Fusion Engine": {
      "formula": "(5000 * engineRating * mechTonnage) / 75",
      "description": "Engine cost based on rating and mech tonnage"
    },
    "Gyro": {
      "formula": "300000 * gyroTonnage",
      "description": "Gyro tonnage = ceil(engineRating / 100)"
    },
    "Jump Jet": {
      "formula": "200 * (jumpJetCount^2) * mechTonnage",
      "description": "Cost increases quadratically with number of jump jets"
    }
  },
  
